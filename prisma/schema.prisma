// Colheita — Cooperativa dos Produtores Rurais de Petropolis
// Schema do ciclo semanal do PNAE: pedido das escolas, pedido/entrega dos
// produtores, devolucoes, balanco financeiro e historico semanal.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------
// Cadastros base (nao mudam toda semana)
// -----------------------------------------------------------------------

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  pricePerKg  Decimal  @db.Decimal(10, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolOrders       SchoolOrder[]
  producerOrders     ProducerOrder[]
  productionEntries  ProductionMapEntry[]

  @@map("products")
}

model School {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  neighborhood String?
  address      String?
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders SchoolOrder[]

  @@map("schools")
}

model Producer {
  id         String   @id @default(cuid())
  internalId String   @unique
  name       String
  phone      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders            ProducerOrder[]
  productionEntries ProductionMapEntry[]

  @@map("producers")
}

model ReturnReason {
  id          String   @id @default(cuid())
  code        Int      @unique
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolOrders   SchoolOrder[]
  producerOrders ProducerOrder[]

  @@map("return_reasons")
}

// Mapa de Producao: referencia anual (ciclo PNAE out-set) de quanto cada
// produtor planeja produzir de cada produto, por mes. Somente consulta —
// nao e editado no ciclo semanal.
model ProductionMapEntry {
  id         String @id @default(cuid())
  productId  String
  producerId String

  out Decimal @db.Decimal(10, 2) @default(0)
  nov Decimal @db.Decimal(10, 2) @default(0)
  dez Decimal @db.Decimal(10, 2) @default(0)
  jan Decimal @db.Decimal(10, 2) @default(0)
  fev Decimal @db.Decimal(10, 2) @default(0)
  mar Decimal @db.Decimal(10, 2) @default(0)
  abr Decimal @db.Decimal(10, 2) @default(0)
  mai Decimal @db.Decimal(10, 2) @default(0)
  jun Decimal @db.Decimal(10, 2) @default(0)
  jul Decimal @db.Decimal(10, 2) @default(0)
  ago Decimal @db.Decimal(10, 2) @default(0)
  set Decimal @db.Decimal(10, 2) @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@unique([productId, producerId])
  @@map("production_map_entries")
}

// Constante de logistica (R$/kg) subtraida do preco somente no pagamento
// ao produtor. Editavel, mas cada ProducerOrder guarda o valor vigente no
// momento (snapshot) para nao alterar semanas ja fechadas.
model Settings {
  id                     Int     @id @default(1)
  logisticsDeductionPerKg Decimal @db.Decimal(10, 2) @default(3.67)

  @@map("settings")
}

// -----------------------------------------------------------------------
// Ciclo semanal
// -----------------------------------------------------------------------

enum WeekStatus {
  OPEN
  CLOSED
}

model Week {
  id        String     @id @default(cuid())
  number    Int        @unique @default(autoincrement())
  startDate DateTime
  endDate   DateTime
  status    WeekStatus @default(OPEN)
  closedAt  DateTime?
  createdAt DateTime   @default(now())

  schoolOrders   SchoolOrder[]
  producerOrders ProducerOrder[]
  costs          WeeklyCost[]

  @@map("weeks")
}

// Pedido + devolucao de cada escola, por produto, na semana.
// Linha so existe se algum valor foi lancado (grid esparso).
model SchoolOrder {
  id       String @id @default(cuid())
  weekId   String
  schoolId String
  productId String

  orderedQty  Decimal @db.Decimal(10, 2) @default(0)
  returnedQty Decimal @db.Decimal(10, 2) @default(0)

  returnReasonId String?

  // preco/kg vigente no momento do lancamento — congela o historico
  pricePerKgSnapshot Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  week         Week          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  returnReason ReturnReason? @relation(fields: [returnReasonId], references: [id])

  @@unique([weekId, schoolId, productId])
  @@index([weekId])
  @@index([schoolId])
  @@map("school_orders")
}

// Pedido + entrega + devolucao de cada produtor, por produto, na semana.
// deliveredQty nulo = entrega ainda nao registrada (pendencia).
model ProducerOrder {
  id         String @id @default(cuid())
  weekId     String
  producerId String
  productId  String

  orderedQty   Decimal  @db.Decimal(10, 2) @default(0)
  deliveredQty Decimal? @db.Decimal(10, 2)
  returnedQty  Decimal  @db.Decimal(10, 2) @default(0)

  returnReasonId String?

  // valores vigentes no momento do lancamento — congela o historico
  pricePerKgSnapshot          Decimal @db.Decimal(10, 2)
  logisticsDeductionSnapshot  Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  week         Week          @relation(fields: [weekId], references: [id], onDelete: Cascade)
  producer     Producer      @relation(fields: [producerId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  returnReason ReturnReason? @relation(fields: [returnReasonId], references: [id])

  @@unique([weekId, producerId, productId])
  @@index([weekId])
  @@index([producerId])
  @@map("producer_orders")
}

enum CostCategory {
  TRANSPORTE
  MONTAGEM
  ADMINISTRATIVO
  EMBALAGENS_MATERIAL_LIMPEZA
  MATERIAL_ESCRITORIO
  IMPOSTOS
  SERVICO_CONTABILIDADE
  AJUDA_CUSTO_CONSELHO
}

model WeeklyCost {
  id       String       @id @default(cuid())
  weekId   String
  category CostCategory
  amount   Decimal      @db.Decimal(12, 2) @default(0)

  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([weekId, category])
  @@map("weekly_costs")
}
