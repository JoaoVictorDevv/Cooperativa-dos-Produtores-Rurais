# String de conexao com o Postgres (em produção, use o Neon/Vercel Postgres)
DATABASE_URL="postgresql://usuario:senha@host:5432/colheita?schema=public"

# Segredo usado para assinar o cookie de sessao - gere um valor aleatorio longo
SESSION_SECRET="troque-por-um-valor-aleatorio-longo"

# Usuario administrador inicial, criado pelo seed (troque a senha depois do primeiro login)
ADMIN_EMAIL="admin@suacooperativa.org"
ADMIN_PASSWORD="troque-esta-senha"
