NODE_ENV=development
PORT=8080
HOST=127.0.0.1
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Settings > API no projeto Supabase.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA

# jwks: recomendado. auth-server: compatibilidade com JWT legado/HS256.
SUPABASE_JWT_MODE=jwks

