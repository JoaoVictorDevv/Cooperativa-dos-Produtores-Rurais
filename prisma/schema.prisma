// Colheita — Cooperativa dos Produtores Rurais de Petropolis
// Sistema de gestao do ciclo PNAE. Modelo normalizado conforme
// especificacao formal: pedido, entrega e devolucao sao SEMPRE tabelas
// independentes (nunca a mesma linha), precos tem historico, semanas
// nunca sao apagadas, e toda alteracao relevante e auditavel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------
// Usuarios e permissoes
// -----------------------------------------------------------------------

enum Role {
  ADMIN
  OPERADOR
  CONSULTA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERADOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs      AuditLog[]
  closedWeeks    Week[]        @relation("WeekClosedBy")
  weekReopenings WeekReopening[]

  @@map("users")
}

// -----------------------------------------------------------------------
// Cadastros base
// -----------------------------------------------------------------------

model Product {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices            Price[]
  productionEntries ProductionMapEntry[]
  schoolOrders      SchoolOrder[]
  schoolReturns     SchoolReturn[]
  producerOrders    ProducerOrder[]
  producerDeliveries ProducerDelivery[]
  producerReturns   ProducerReturn[]
  allocations       ProducerAllocation[]

  @@map("products")
}

model School {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  neighborhood String?
  address      String?
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders     SchoolOrder[]
  deliveries SchoolDelivery[]
  returns    SchoolReturn[]

  @@map("schools")
}

model Producer {
  id         String   @id @default(cuid())
  internalId String   @unique
  name       String
  phone      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  productionEntries ProductionMapEntry[]
  orders            ProducerOrder[]
  deliveries        ProducerDelivery[]
  returns           ProducerReturn[]
  allocations       ProducerAllocation[]

  @@map("producers")
}

model ReturnReason {
  id          String   @id @default(cuid())
  code        Int      @unique
  description String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolReturns   SchoolReturn[]
  producerReturns ProducerReturn[]

  @@map("return_reasons")
}

// Historico de precos por produto. "Preco vigente" = a linha sem validTo
// (ou cujo periodo [validFrom, validTo) contem a data de referencia).
// Nunca sobrescrever: uma alteracao de preco fecha a linha atual
// (seta validTo) e cria uma nova a partir da data informada.
model Price {
  id         String    @id @default(cuid())
  productId  String
  price      Decimal   @db.Decimal(10, 2)
  validFrom  DateTime
  validTo    DateTime?
  createdAt  DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  schoolOrders       SchoolOrder[]
  producerOrders     ProducerOrder[]
  producerDeliveries ProducerDelivery[]

  @@index([productId, validFrom])
  @@map("prices")
}

// Mapa de Producao: referencia anual (ciclo PNAE out-set) de quanto cada
// produtor planeja produzir de cada produto, por mes. Somente consulta —
// alterar isto nunca afeta semanas ja lancadas (CA-MAPA-04).
model ProductionMapEntry {
  id         String @id @default(cuid())
  productId  String
  producerId String

  out Decimal @db.Decimal(10, 2) @default(0)
  nov Decimal @db.Decimal(10, 2) @default(0)
  dez Decimal @db.Decimal(10, 2) @default(0)
  jan Decimal @db.Decimal(10, 2) @default(0)
  fev Decimal @db.Decimal(10, 2) @default(0)
  mar Decimal @db.Decimal(10, 2) @default(0)
  abr Decimal @db.Decimal(10, 2) @default(0)
  mai Decimal @db.Decimal(10, 2) @default(0)
  jun Decimal @db.Decimal(10, 2) @default(0)
  jul Decimal @db.Decimal(10, 2) @default(0)
  ago Decimal @db.Decimal(10, 2) @default(0)
  set Decimal @db.Decimal(10, 2) @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@unique([productId, producerId])
  @@map("production_map_entries")
}

// Constante de logistica (R$/kg), regra absoluta #7. Nao tem historico
// dedicado (nao e um "preco" no sentido do CA-PRECO-*), mas cada
// ProducerDelivery grava o valor vigente no momento (snapshot) para
// nunca alterar retroativamente um pagamento ja calculado.
model Settings {
  id                      Int     @id @default(1)
  logisticsDeductionPerKg Decimal @db.Decimal(10, 2) @default(3.67)

  @@map("settings")
}

// -----------------------------------------------------------------------
// Semana operacional
// -----------------------------------------------------------------------

enum WeekStatus {
  ABERTA
  FECHADA
}

model Week {
  id            String     @id @default(cuid())
  number        Int        @unique @default(autoincrement())
  referenceDate DateTime // data de referencia do ciclo (ex.: domingo da semana)
  startDate     DateTime
  endDate       DateTime
  status        WeekStatus @default(ABERTA)
  notes         String?

  createdAt DateTime  @default(now())
  closedAt  DateTime?
  closedById String?

  closedBy    User?           @relation("WeekClosedBy", fields: [closedById], references: [id])
  reopenings  WeekReopening[]

  schoolOrders        SchoolOrder[]
  schoolDeliveries    SchoolDelivery[]
  schoolReturns       SchoolReturn[]
  producerAllocations ProducerAllocation[]
  producerOrders      ProducerOrder[]
  producerDeliveries  ProducerDelivery[]
  producerReturns     ProducerReturn[]
  costs               WeeklyCost[]

  @@map("weeks")
}

// Toda reabertura de uma semana fechada precisa de usuario, data/hora e
// motivo (CA-SEM-06, CA-AUD-03). Pode acontecer mais de uma vez.
model WeekReopening {
  id        String   @id @default(cuid())
  weekId    String
  userId    String
  reason    String
  createdAt DateTime @default(now())

  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("week_reopenings")
}

// -----------------------------------------------------------------------
// Escolas: pedido, entrega (data) e devolucao SEMPRE em tabelas separadas
// -----------------------------------------------------------------------

// PEDIDO da escola. Formula (regra absoluta #5): liquido = pedido - devolucao
// (a devolucao vem de SchoolReturn, nunca desta tabela).
model SchoolOrder {
  id        String  @id @default(cuid())
  weekId    String
  schoolId  String
  productId String

  orderedQty Decimal @db.Decimal(10, 2) @default(0)

  // preco vigente no momento do lancamento — rastreavel (CA-PRECO-05)
  priceId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  week    Week    @relation(fields: [weekId], references: [id], onDelete: Cascade)
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  price   Price   @relation(fields: [priceId], references: [id])

  @@unique([weekId, schoolId, productId])
  @@index([weekId])
  @@index([schoolId])
  @@map("school_orders")
}

// Confirmacao operacional de ENTREGA a escola (nao entra na formula
// financeira — so registra quando/qual dia a escola foi atendida).
enum DeliveryWeekday {
  SEGUNDA
  TERCA
  EXCEPCIONAL
}

model SchoolDelivery {
  id         String          @id @default(cuid())
  weekId     String
  schoolId   String
  weekday    DeliveryWeekday
  deliveredAt DateTime
  note       String?
  createdAt  DateTime        @default(now())

  week   Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([weekId, schoolId])
  @@index([weekId])
  @@map("school_deliveries")
}

model SchoolReturn {
  id        String @id @default(cuid())
  weekId    String
  schoolId  String
  productId String

  returnedQty    Decimal @db.Decimal(10, 2)
  returnReasonId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  week         Week         @relation(fields: [weekId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  returnReason ReturnReason @relation(fields: [returnReasonId], references: [id])

  @@index([weekId])
  @@index([schoolId])
  @@map("school_returns")
}

// -----------------------------------------------------------------------
// Produtores: divisao (planejamento), pedido, entrega e devolucao —
// quatro conceitos, quatro tabelas, todas independentes entre si.
// -----------------------------------------------------------------------

// Etapa de planejamento: como a demanda das escolas foi dividida entre
// produtores, ANTES de o pedido efetivo ser colocado (CA-DIV-*).
// Alterar isto nunca alcanca pedido/entrega automaticamente.
model ProducerAllocation {
  id         String @id @default(cuid())
  weekId     String
  productId  String
  producerId String

  allocatedQty Decimal @db.Decimal(10, 2) @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  week     Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@unique([weekId, productId, producerId])
  @@index([weekId])
  @@map("producer_allocations")
}

// PEDIDO ao produtor — independente da entrega (regra absoluta #1).
model ProducerOrder {
  id         String @id @default(cuid())
  weekId     String
  producerId String
  productId  String

  orderedQty Decimal @db.Decimal(10, 2) @default(0)
  priceId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  week     Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price    Price    @relation(fields: [priceId], references: [id])

  @@unique([weekId, producerId, productId])
  @@index([weekId])
  @@index([producerId])
  @@map("producer_orders")
}

// ENTREGA real do produtor (normalmente domingo). E esta tabela — nunca
// o pedido — que alimenta o pagamento (regra absoluta #4).
model ProducerDelivery {
  id         String   @id @default(cuid())
  weekId     String
  producerId String
  productId  String

  deliveredQty Decimal  @db.Decimal(10, 2)
  deliveredAt  DateTime

  // valores vigentes no momento do lancamento — rastreavel e congela o
  // pagamento historico mesmo que preco/deducao mudem depois
  priceId                    String
  logisticsDeductionSnapshot Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  week     Week     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price    Price    @relation(fields: [priceId], references: [id])

  @@unique([weekId, producerId, productId])
  @@index([weekId])
  @@index([producerId])
  @@map("producer_deliveries")
}

model ProducerReturn {
  id         String @id @default(cuid())
  weekId     String
  producerId String
  productId  String

  returnedQty    Decimal @db.Decimal(10, 2)
  returnReasonId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  week         Week         @relation(fields: [weekId], references: [id], onDelete: Cascade)
  producer     Producer     @relation(fields: [producerId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  returnReason ReturnReason @relation(fields: [returnReasonId], references: [id])

  @@index([weekId])
  @@index([producerId])
  @@map("producer_returns")
}

// -----------------------------------------------------------------------
// Financeiro da semana
// -----------------------------------------------------------------------

enum CostCategory {
  TRANSPORTE
  MONTAGEM
  ADMINISTRATIVO
  EMBALAGENS_MATERIAL_LIMPEZA
  MATERIAL_ESCRITORIO
  IMPOSTOS
  SERVICO_CONTABILIDADE
  AJUDA_CUSTO_CONSELHO
}

model WeeklyCost {
  id       String       @id @default(cuid())
  weekId   String
  category CostCategory
  amount   Decimal      @db.Decimal(12, 2) @default(0)

  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([weekId, category])
  @@map("weekly_costs")
}

// -----------------------------------------------------------------------
// Auditoria (secao 49-50): quem, quando, o que mudou
// -----------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
